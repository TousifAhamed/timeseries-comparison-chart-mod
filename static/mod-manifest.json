{
    "apiVersion": "1.3",
    "version": "2.0.0",
    "name": "Time Series Comparison Chart",
    "id": "spotfire-timeseries-comparison-chart",
    "icon": "icon.svg",
    "properties": [
        {
            "name": "timePeriod",
            "type": "string",
            "defaultValue": "MAX"
        },
        {
            "name": "selectedMarket",
            "type": "string",
            "defaultValue": ""
        },
        {
            "name": "showGrid",
            "type": "boolean",
            "defaultValue": true
        },
        {
            "name": "animateLines",
            "type": "boolean",
            "defaultValue": true
        },
        {
            "name": "showLegend",
            "type": "boolean",
            "defaultValue": true
        },
        {
            "name": "mod-config",
            "type": "string",
            "defaultValue": ""
        }
    ],
    "dataViewDefinition": {
        "tooltip": { "enabled": true },
        "colorAxis": {
            "mode": "categorical",
            "dropTarget": {
                "icon": "Color",
                "description": "Series Name (e.g., DAX, FTSE 100)"
            }
        },
        "axes": [
            {
                "name": "X",
                "mode": "categorical",
                "placement": "bottom",
                "dropTarget": {
                    "icon": "XAxis3D",
                    "description": "Date/Time Column"
                },
                "propertyControl": {
                    "title": "Date"
                },
                "legendItem": {
                    "title": "Date",
                    "defaultVisibility": "hidden"
                }
            },
            {
                "name": "Y",
                "mode": "continuous",
                "allowMultipleMeasures": false,
                "placement": "left",
                "dropTarget": {
                    "icon": "YAxis3D",
                    "description": "Percentage Change Value"
                },
                "propertyControl": {
                    "title": "% Change"
                },
                "legendItem": {
                    "title": "% Change",
                    "defaultVisibility": "hidden"
                }
            },
            {
                "name": "MarketType",
                "mode": "categorical",
                "dropTarget": {
                    "icon": "TableCategories",
                    "description": "Market Type (e.g., US, Europe, Asia)"
                },
                "propertyControl": {
                    "title": "Market Type"
                }
            },
            {
                "name": "CurrentValue",
                "mode": "continuous",
                "dropTarget": {
                    "icon": "Size",
                    "description": "Current Value (e.g., 24,894.44)"
                },
                "propertyControl": {
                    "title": "Current Value"
                }
            },
            {
                "name": "ValueChange",
                "mode": "continuous",
                "dropTarget": {
                    "icon": "ZAxis3D",
                    "description": "Value Change (e.g., +355.10)"
                },
                "propertyControl": {
                    "title": "Value Change"
                }
            }
        ]
    },
    "files": [
        "index.html",
        "main.css",
        "bundle.js"
    ]
}