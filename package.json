    "description": "A modern time series comparison chart mod for TIBCO Spotfire - compare multiple data series over time with interactive features and theme support",
    "main": "index.js",
    "scripts": {
        "server": "mods-dev-server dist",
        "build": "webpack --mode production --no-devtool",
        "build-watch": "webpack --watch",
        "start": "npm run build-watch"
    },
    "keywords": [
        "spotfire",
        "mods",
        "visualization",
        "chart",
        "time-series",
        "d3",
        "comparison",
        "tibco"
    ],
